
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Set Your Password | Tir Chonaill Careers</title>
  <link rel="stylesheet" href="css/style.css">
  <link rel="icon" href="images/logo.jpg" type="image/jpeg">
</head>
<body>
<header class="header">
  <div class="container nav">
    <a class="brand" href="index.html">
      <img src="images/logo.jpg" alt="Tir Chonaill Careers">
      <div><strong>TIR CHONAILL</strong><small>CAREERS</small></div>
    </a>
  </div>
</header>

<main class="section">
  <div class="container" style="max-width:520px">
    <h1>Set your password</h1>
    <p>Create a password for your private recruitment dashboard.</p>

    <form id="passwordForm" class="form" hidden>
      <label for="password">New password</label>
      <input class="input" id="password" type="password"
             autocomplete="new-password" minlength="12" required>

      <label for="confirmPassword">Confirm password</label>
      <input class="input" id="confirmPassword" type="password"
             autocomplete="new-password" minlength="12" required>

      <button class="btn btn-green" id="saveButton" type="submit">
        Save password
      </button>
    </form>

    <p id="status" role="status" aria-live="polite">
      Checking your invitation...
    </p>
  </div>
</main>

<script type="module">
  import { createClient } from
    "https://esm.sh/@supabase/supabase-js@2";

  const supabase = createClient(
    "https://wqybomkrofcctkpgrqdf.supabase.co",
    "sb_publishable_SKJ0iSUfbHTuyHkgIEgRMw_gqRWVfPA"
  );

  const form = document.getElementById("passwordForm");
  const status = document.getElementById("status");
  const saveButton = document.getElementById("saveButton");

  const { data: { session } } = await supabase.auth.getSession();

  if (session) {
    form.hidden = false;
    status.textContent = "";
  } else {
    status.textContent =
      "This invitation is invalid or has expired. Please request a new invitation.";
  }

  supabase.auth.onAuthStateChange((_event, session) => {
    if (session) {
      form.hidden = false;
      status.textContent = "";
    }
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    const password = document.getElementById("password").value;
    const confirm = document.getElementById("confirmPassword").value;

    if (password !== confirm) {
      status.textContent = "Passwords do not match.";
      return;
    }

    saveButton.disabled = true;
    status.textContent = "Saving your password...";

    const { error } = await supabase.auth.updateUser({ password });

    if (error) {
      status.textContent = error.message;
      saveButton.disabled = false;
      return;
    }

    status.textContent = "Password saved. Opening your dashboard...";
    window.location.replace("dashboard.html");
  });
</script>
</body>
</html>
